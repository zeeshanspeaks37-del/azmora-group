{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/import-export", "destination": "/services/import-export.html" },
    { "source": "/coal-trading", "destination": "/services/coal-trading.html" },
    { "source": "/shipping-logistics", "destination": "/services/shipping-logistics.html" },
    { "source": "/furniture", "destination": "/services/furniture.html" },
    { "source": "/azmora-estate", "destination": "/services/azmora-estate.html" },
    { "source": "/azmora-healthcare", "destination": "/services/azmora-healthcare.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
